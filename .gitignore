# Runtime secrets & state — regenerate on first run; never transfer
gateway/pki/
gateway/data/*.jsonl
gateway/data/*.json
gateway/data/*.log
# Production TLS material + proxy secret (generated per-deployment, never commit)
gateway/deploy/tls/
gateway/deploy/proxy_secret
# Dev/verification scratch pages (may embed test credentials)
gateway/ui/_*.html

# Node / dashboard build tooling
node_modules/
gateway/dashboard/dist/
.vite/
*.tsbuildinfo

# Large build artifacts — rebuild these, never store them in git
*.tar
*.bundle
gateway/*.tar

# Unrelated saved web pages (not part of the project)
Google Gemini.html
Google Gemini_files/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db

# Reference dashboard designs (third-party Figma exports / working material — not project source)
ref/
mcp-gateway-dashboard/
mcp-gateway-dashboard-v2/
dashboard-ref/
*.zip
gateway/deploy/secrets/
gateway/.env
.env

# MFA QR (contains the TOTP seed — never commit)
admin-mfa-qr.png
*mfa-qr*.png
*aegis-qr*.png
*-qr.png

# Runtime state & generated report output (never commit)
gateway/data/

# opendata-mcp is its own repository (gitea: adel/open-data-mcp) — not a submodule
opendata-mcp/

# Screen recordings (not project source)
*.mp4

# Office lock files
~$*
**/~$*
